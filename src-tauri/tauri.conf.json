{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organizador de tareas",
  "version": "0.1.0",
  "identifier": "com.organizadortareas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Organizador de tareas",
        "width": 640,
        "height": 440,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "appimage", "deb"],
    "shortDescription": "Organizador de tareas ligero de escritorio",
    "category": "Productivity",
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
